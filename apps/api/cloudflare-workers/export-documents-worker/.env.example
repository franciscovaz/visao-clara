# Export documents Worker — local environment
# Used by: npm run dev (wrangler dev --env development) via .dev.vars,
# which overrides [env.development.vars] in wrangler.toml.
# Copy to .dev.vars and fill in. Never commit .dev.vars.
# Production: `wrangler secret put <NAME> --env production` for secrets;
# non-secret values and the R2 bucket binding live in wrangler.toml.

# Supabase (the Worker runs on the host, so use the public local URL)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-or-secret-key

# Shared with Edge Functions (supabase/functions/.env) — must be identical in both
EXPORT_JWT_SECRET=your-random-secret-at-least-32-characters

# Storage provider: "s3" for local development, "r2" in production (R2 binding)
STORAGE_PROVIDER=s3

# Local S3 (Supabase Storage S3 protocol; same values as the Edge Functions)
S3_ENDPOINT_URL=http://127.0.0.1:54321/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=local
S3_BUCKET=visao-clara-documents
