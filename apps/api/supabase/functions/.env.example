# Supabase Edge Functions — local environment
# Used by: supabase functions serve --env-file supabase/functions/.env
# Copy to supabase/functions/.env and fill in. Never commit supabase/functions/.env.
# Production: set the same names with `supabase secrets set` (or the dashboard).
#
# Note: the CLI ignores names starting with SUPABASE_ in this file and injects
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY itself.

# Supabase (functions run in Docker, so use the internal gateway host)
VC_SUPABASE_URL=http://kong:8000
VC_SUPABASE_ANON_KEY=your-local-anon-key

# File storage provider: "local_s3" (local Supabase Storage) or "r2" (Cloudflare R2)
FILE_STORAGE_PROVIDER=local_s3

# Local S3 (Supabase Storage S3 protocol, `supabase status` shows the keys)
# S3_ENDPOINT_URL is used to sign browser-facing URLs (upload/download)
S3_ENDPOINT_URL=http://127.0.0.1:54321/storage/v1/s3
# Used for requests made by the functions themselves (e.g. delete-document)
S3_INTERNAL_ENDPOINT_URL=http://kong:8000/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=local
S3_BUCKET=visao-clara-documents

# Cloudflare R2 (only when FILE_STORAGE_PROVIDER=r2)
VC_R2_ACCOUNT_ID=your-r2-account-id
VC_R2_ACCESS_KEY_ID=your-r2-access-key-id
VC_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
VC_R2_BUCKET=your-r2-bucket-name
VC_R2_REGION=auto

# OpenAI (AI checklist suggestions and chat assistant)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Shared with the export Worker (.dev.vars) — must be identical in both
EXPORT_JWT_SECRET=your-random-secret-at-least-32-characters
