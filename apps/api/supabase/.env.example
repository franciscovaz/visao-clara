# Supabase CLI — local Auth configuration
# Read by `supabase start` to resolve env(...) values in supabase/config.toml.
# Copy to supabase/.env, fill in, then restart: supabase stop && supabase start
# Never commit supabase/.env.

# Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web application")
# Authorised redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret
