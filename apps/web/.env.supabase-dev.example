# DEV CLOUD — Next.js on this machine against the Supabase project visao-clara-dev.
# Copy to .env.supabase-dev (Git-ignored) and run `pnpm dev:cloud` (http://localhost:3001).
NEXT_PUBLIC_APP_ENV=dev
# Must be exactly the visao-clara-dev project (enforced by env-validation.cjs)
NEXT_PUBLIC_SUPABASE_URL=https://xqdsxkmtzkccnbdiuzhn.supabase.co
# visao-clara-dev dashboard -> Project Settings -> API Keys: the publishable / anon key (never a secret key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-publishable-key
# Optional DEV export Worker (https); leave empty until one is deployed
NEXT_PUBLIC_WORKER_URL=
