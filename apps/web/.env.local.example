# Supabase Configuration for Frontend
# Add your Supabase project URL and anon key here
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: shown as "anon key" (or "Publishable key") by `supabase status` in apps/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare Worker URL for document exports
# Local development: http://127.0.0.1:8787
# Production: your Cloudflare Worker URL
NEXT_PUBLIC_WORKER_URL=http://127.0.0.1:8787
