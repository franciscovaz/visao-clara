# LOCAL — Next.js on this machine against Supabase Docker (apps/api: `supabase start`).
# Copy to .env.supabase-local (Git-ignored) and run `pnpm dev:local` (http://localhost:3000).
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Shown as the publishable / anon key by `supabase status` in apps/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key
# Local export Worker (`npm run dev` in apps/api/cloudflare-workers/export-documents-worker)
NEXT_PUBLIC_WORKER_URL=http://127.0.0.1:8787
